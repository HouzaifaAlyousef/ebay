# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# WICHTIG: .env niemals committen!

# --- LLM API Keys (nur den passenden setzen) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: Login-Daten (nur falls du auto-send ohne manuelles Login willst) ---
# Empfehlung: Leer lassen und einmalig manuell einloggen (siehe README: "login"-Befehl).
KLEINANZEIGEN_EMAIL=
KLEINANZEIGEN_PASSWORD=
